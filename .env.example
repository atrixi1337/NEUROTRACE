# =============================================================================
# NEUROTRACE — environment configuration template
# Copy to `.env` and fill in the keys you want to enable.
# =============================================================================

# ---- LLM provider -----------------------------------------------------------
# Pick one. The first one with a key wins if NEUROTRACE_LLM_PROVIDER is unset.

# AkashML — decentralized GPU inference (recommended)
AKASHML_API_KEY=akml-your-key-here

# Or OpenAI directly
# OPENAI_API_KEY=sk-...

# Or OpenRouter (400+ models, OpenAI-compatible)
# OPENROUTER_API_KEY=sk-or-...

# Or Ollama (local, no auth)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# NEUROTRACE_OLLAMA_URL=http://host.docker.internal:11434/v1

# Force a specific provider and model. Default model is openai/gpt-oss-20b.
NEUROTRACE_LLM_PROVIDER=akashml
NEUROTRACE_LLM_MODEL=openai/gpt-oss-20b

# ---- Velociraptor -----------------------------------------------------------
# NEUROTRACE can call a live Velociraptor server to trigger hunts and
# acquire memory dumps. Leave blank to use the local mock client.
VELO_API_URL=https://localhost:8001/
VELO_API_KEY=
VELO_VERIFY_TLS=false
VELO_CLIENT_ID=neurotrace

# ---- Engine -----------------------------------------------------------------
# Maximum bytes of any single memory dump to keep resident in RAM.
# Streaming mmap ignores this for VAD walks but the credential/strings
# regex scans read the whole dump unless you set a cap.
MAX_SCAN_BYTES=1073741824

# Suspicious-RWX entropy threshold (0.0 - 8.0)
RWX_PAGE_SUSPICIOUS_ENTROPY=6.2
